{
  "name": "routeburn-release-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Release tooling for RouteBurn. RouteBurn itself is a Go application and is not published to npm.",
  "engines": {
    "node": "^22.22.2 || >=24.15"
  },
  "scripts": {
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "commitlint": "commitlint",
    "check:release-notes": "node scripts/check-release-notes.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "26.0.1"
  }
}
