{
  "name": "routeburn-release-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Release tooling for RouteBurn. RouteBurn itself is a Go application and is not published to npm.",
  "engines": {
    "node": ">=26.13"
  },
  "scripts": {
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "commitlint": "commitlint",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "check:html": "html-validate \"site/**/*.html\"",
    "check:links": "node tests/site/check-links.mjs",
    "test:site": "playwright test",
    "check:lighthouse": "node scripts/lighthouse-site.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "14.0.0-beta.4",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/release-notes-generator": "15.0.0-beta.3",
    "chrome-launcher": "1.2.3",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "html-validate": "11.21.1",
    "lighthouse": "13.6.0",
    "semantic-release": "26.0.1",
    "sharp": "0.35.5"
  }
}
